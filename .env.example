# Copy to .env. Never commit the populated file.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
# The teaching pack to work on: a folder with objective.md and curriculum/ (relative to this directory).
TEACHING_PACK_DIR=./packs/grade7-mathematics-term1
# The curriculum follows the teaching pack's folder name (packs/<id> ->
# curriculum/<id>.json). Set CURRICULUM_PACK only to override that pairing.
#CURRICULUM_PACK=grade7-mathematics-term1
# Verification layer for new runs: the checks in verification/ (off | on).
VERIFICATION=off
# Independent judge model: must differ from MODEL_API_MODEL. Set this to the
# review deployment before using ./helper verify RUN --independent live.
JUDGE_MODEL=
# Email sharing (./helper send): generic SMTP. Never commit real credentials.
# Gmail: host smtp.gmail.com, port 587, user your address, password an App
# Password (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_TLS=yes (STARTTLS; port 465 uses SSL instead; set to no only for a
# local relay without TLS).

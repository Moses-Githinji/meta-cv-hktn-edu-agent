#!/usr/bin/env bash
set -euo pipefail

# The agent's own Python: ./helper setup creates .venv here and installs requirements.txt.
if [[ -z "${PYTHON:-}" ]]; then
  if [[ -x .venv/bin/python ]]; then PYTHON=.venv/bin/python; else PYTHON=python3; fi
fi
COMMAND="${1:-help}"
shift || true

load_env() {
  # TEACHING_PACK_DIR set in the environment wins over .env.
  local pack_dir="${TEACHING_PACK_DIR:-}"
  if [[ -f .env ]]; then
    set -a
    # shellcheck disable=SC1091
    source .env
    set +a
  fi
  if [[ -n "$pack_dir" ]]; then export TEACHING_PACK_DIR="$pack_dir"; fi
}

case "$COMMAND" in
  setup)
    [[ -f .env ]] || cp .env.example .env
    [[ -x .venv/bin/python ]] || python3 -m venv .venv
    .venv/bin/python -m pip install --quiet --disable-pip-version-check -r requirements.txt
    PYTHON=.venv/bin/python
    load_env
    "$PYTHON" scripts/reset_case.py
    "$PYTHON" scripts/preflight.py --expect-release initial --check-key
    ;;
  reset)
    load_env
    "$PYTHON" scripts/reset_case.py "$@"
    ;;
  run)
    load_env
    "$PYTHON" -m teaching_agent "$@"
    ;;
  review)
    "$PYTHON" scripts/review.py "$@"
    ;;
  describe)
    load_env
    "$PYTHON" scripts/describe.py "$@"
    ;;
  verify)
    load_env
    "$PYTHON" scripts/verify.py "$@"
    ;;
  branch)
    load_env
    "$PYTHON" scripts/branch.py "$@"
    ;;
  pipeline)
    "$PYTHON" scripts/pipeline.py "$@"
    ;;
  export)
    "$PYTHON" scripts/export.py "$@"
    ;;
  send)
    load_env
    "$PYTHON" scripts/send.py "$@"
    ;;
  eval)
    "$PYTHON" scripts/eval.py "$@"
    ;;
  dashboard)
    "$PYTHON" scripts/dashboard.py "$@"
    ;;
  retention)
    "$PYTHON" scripts/retention.py "$@"
    ;;
  ui)
    "$PYTHON" ui/ui.py "$@"
    ;;
  test)
    load_env
    if [[ "${1:-}" == "--verification" ]]; then export VERIFICATION=on; else export VERIFICATION=off; fi
    "$PYTHON" scripts/preflight.py --expect-release auto
    "$PYTHON" -m unittest discover -s tests
    ;;
  *)
    cat >&2 <<'USAGE'
Usage: ./helper COMMAND
  setup                                  create .venv, copy the pack's documents, check MODEL_API_KEY
  test [--verification]                  offline tests (no API calls)
  run [--turns N] [--resume RUN_ID]      run the agent, or continue a run
  verify RUN_ID --memo | --checklist | --independent
                                         run the checks on a finished run
  branch RUN_ID                          continue a run from its checklist with verification on
  review RUN_ID --list [--json]          one row per item, with curriculum text
  review RUN_ID --item ITEM --approve | --reject --notes "..." | --edit --notes "..."
  review RUN_ID --approve | --reject --notes "..." | --answer R1 --notes "..."
  review RUN_ID --hod-approve | --hod-reject --notes "..."   (exam documents)
  pipeline fetch|discover|drive-download|extract|gates|diff|publish|rollback|staleness|refresh|schedule|propose-dates|alerts
  export RUN --what scheme|exam|marking-scheme|lesson-plan --format docx|pdf [--out FILE]
  send RUN --what WHAT --format docx|pdf --to ADDR [--subject S] [--message M] [--dry-run]
                                         email a document as an attachment (SMTP_* in .env)
  eval [--task ID] [--live] [--shadow JUDGE]
  dashboard [--json] [--html FILE] [--alerts]
  retention [--days N] [--apply]
  ui [--port N] [--root PATH]           start the browser console (http://127.0.0.1:8765)
  reset [--clear-runs]                   reset the inbox to the pack's documents
  describe                               what the agent gets (JSON; used by the console)
USAGE
    exit 2
    ;;
esac

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grade 7 Mathematics curriculum pack (one term)",
  "type": "object",
  "required": ["pack", "source", "term", "strands"],
  "properties": {
    "pack": {
      "type": "object",
      "required": ["id", "learning_area", "grade", "curriculum", "term", "version"],
      "properties": {
        "id": {"type": "string"},
        "learning_area": {"enum": ["Mathematics", "Christian Religious Education", "English", "Kiswahili", "Agriculture", "French"]},
        "grade": {"enum": [7]},
        "curriculum": {"enum": ["CBC"]},
        "term": {"type": "integer", "minimum": 1, "maximum": 3},
        "version": {"type": "string"}
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "edition", "publisher"],
      "properties": {
        "title": {"type": "string"},
        "edition": {"type": "string"},
        "publisher": {"const": "Kenya Institute of Curriculum Development"},
        "portal": {"type": "string"}
      }
    },
    "term": {
      "type": "object",
      "required": ["weeks", "lessons_per_week"],
      "properties": {
        "weeks": {"type": "integer", "minimum": 1},
        "lessons_per_week": {"type": "integer", "minimum": 1}
      }
    },
    "strands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "number", "name", "sub_strands"],
        "properties": {
          "id": {"type": "string"},
          "number": {"type": "string"},
          "name": {"type": "string"},
          "sub_strands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "week_range", "outcomes"],
              "properties": {
                "id": {"type": "string"},
                "name": {"type": "string"},
                "week_range": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {"type": "integer", "minimum": 1}
                },
                "outcomes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "outcome_text", "source_ref", "status"],
                    "properties": {
                      "id": {"type": "string"},
                      "outcome_text": {"type": "string", "minLength": 1},
                      "source_ref": {"type": "string", "minLength": 1},
                      "status": {
                        "type": "string",
                        "enum": ["transcribed", "pending_transcription"]
                      },
                      "suggested_learning_experiences": {
                        "type": "array",
                        "items": {"type": "string", "minLength": 1}
                      },
                      "key_inquiry_questions": {
                        "type": "array",
                        "items": {"type": "string", "minLength": 1}
                      },
                      "assessment": {
                        "type": "array",
                        "items": {"type": "string", "minLength": 1}
                      },
                      "learning_resources": {
                        "type": "array",
                        "items": {"type": "string", "minLength": 1}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
